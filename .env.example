# ── Existing settings ──────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── API ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── File uploads ───────────────────────────────────────
MAX_FILE_SIZE_MB=20              # max size per file
MAX_FILES_PER_REQUEST=5          # max files in one API call
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md

# ── Auto-delete uploaded files ─────────────────────────
UPLOAD_AUTO_DELETE_HOURS=24      # delete after 24 hours
                                 # set to 0 to NEVER delete

# ── Session TTL ────────────────────────────────────────
SESSION_TTL_HOURS=24             # session expires after 24h
                                 # set to 0 to NEVER expire

# ── General mode (DuckDuckGo) ──────────────────────────
DDG_MAX_RESULTS=5                # web results to fetch

BRAVE_API_KEY=your_key_here